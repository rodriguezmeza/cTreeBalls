# Set of declarations from C to python
# Only define quantities you will use,
# for input, output or intermediate manipulations
# by the python wrapper. The rest is internal in cBalls

#B
from libc.stdio cimport FILE
from libc.time cimport clock_t
from libc.stddef cimport size_t
#E


cdef extern from "cballs.h":

    cdef char[10] _VERSION_
    ctypedef char FileArg[{{FILEARG_SIZE}}]
    ctypedef char ErrorMsg[{{ERRORMSG_SIZE}}]
    ctypedef {{INTEGER_CTYPE}} INTEGER

    size_t sizeof_cmdline_data()
    size_t sizeof_global_data()

    cdef struct cballs_runtime_state:
        pass

    cballs_runtime_state *cballs_runtime_create()
    int cballs_runtime_activate(cballs_runtime_state *)
    const void *cballs_runtime_bodytable_at(const cballs_runtime_state *, int)
    void cballs_runtime_destroy(cballs_runtime_state *)

    cdef struct cmdline_data:
        char * paramfile

        #B Parameters related to the searching method
        char * searchMethod
        int mChebyshev
        int nsmooth
        #E
        char * rsmooth                                 # use to smooth pivot
        double theta
        unsigned char usePeriodic
        #E

        #B Parameters about the I/O file(s)
        # Input catalog parameters
        char * infile
        char * infilefmt
        #E
        char * iCatalogs
        # Output parameters
        char * rootDir
        char * outfile
        char * outfilefmt
        # Parameters to set a region in the sky, for example for Takahasi data set
        double thetaL
        double thetaR
        double phiL
        double phiR
        #E

        #B Parameters to control histograms and their output files
        unsigned char useLogHist
        int logHistBinsPD
        #
        int sizeHistN
        double rangeN
        double rminHist
        int sizeHistPhi
        #
        char * histNNFileName
        char * histXi2pcfFileName
        char * histZetaFileName
        char * suffixOutFiles                  # deprecated... in favor or no .txt
        #E

        #B Set of parameters needed to construct a test model
        int seed
        char * testmodel
        long nbody
        double lengthBox
        #E

        #B Miscellaneous parameters
        char * preScript
        char * posScript
        #long stepState
        short verbose
        short verbose_log
        int numthreads
        char * options
        unsigned long long options_cache_flags
        short options_cache_valid
        #E
    
        ErrorMsg error_message

{{CMDLINE_CLASSLIB_FIELDS}}


