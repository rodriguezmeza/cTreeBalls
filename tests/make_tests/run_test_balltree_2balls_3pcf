"$PYTHON" - "$TMP_ROOT/auto.txt" "$TMP_ROOT/exact-one" \
              "$TMP_ROOT/exact-normalized" auto <<'PY'
import itertools
import math
import pathlib
import sys

catalog_path = pathlib.Path(sys.argv[1])
output_path = pathlib.Path(sys.argv[2])
normalized_path = pathlib.Path(sys.argv[3])
mode = sys.argv[4]
rows = [tuple(map(float, line.split()))
        for line in catalog_path.read_text(encoding="ascii").splitlines()
        if line.strip()]
# Angular catalogs retain their observer-relative input frame.

rmin = 0.02
rmax = 1.4
nbins = 5
orders = 4
width = (rmax - rmin) / nbins
expected = {name: [[[0.0 for _ in range(nbins)] for _ in range(nbins)]
                   for _ in range(orders)]
            for name in ("cos", "sin", "sincos", "cossin")}
denominator = [[0.0 for _ in range(nbins)] for _ in range(nbins)]

def polar(pivot, neighbor):
    def dot(a, b):
        return sum(x*y for x, y in zip(a, b))
    def cross(a, b):
        return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2],
                a[0]*b[1]-a[1]*b[0])
    dr = tuple(pivot[i]-neighbor[i] for i in range(3))
    distance = math.sqrt(dot(dr, dr))
    radius = math.sqrt(dot(pivot, pivot))
    if not radius or not distance:
        return None
    normal = tuple(x/radius for x in pivot)
    axis = min(range(3), key=lambda i: abs(normal[i]))
    first = tuple((1.0 if i == axis else 0.0)-normal[axis]*normal[i]
                  for i in range(3))
    length = math.sqrt(dot(first, first))
    first = tuple(x/length for x in first)
    second = cross(first, normal)
    cosine, sine = -dot(dr, first), -dot(dr, second)
    length = math.hypot(cosine, sine)
    if length <= 1e-14*distance:
        return None
    return distance, cosine/length, sine/length

def radial_bin(distance):
    if not rmin < distance < rmax:
        return None
    index = int((distance - rmin) / width)
    return index if 0 <= index < nbins else None

for ip, iq, ir in itertools.permutations(range(len(rows)), 3):
    pivot = rows[ip]
    q = rows[iq]
    r = rows[ir]
    pq, pr = polar(pivot[:3], q[:3]), polar(pivot[:3], r[:3])
    if pq is None or pr is None:
        continue
    dq, cosq1, sinq1 = pq
    dr, cosr1, sinr1 = pr
    nq = radial_bin(dq)
    nr = radial_bin(dr)
    if nq is None or nr is None:
        continue
    denominator[nq][nr] += 1.0
    numerator = pivot[3] * q[3] * r[3]
    cosq = cosr = 1.0
    sinq = sinr = 0.0
    for order in range(orders):
        expected["cos"][order][nq][nr] += numerator * cosq * cosr
        expected["sin"][order][nq][nr] += numerator * sinq * sinr
        expected["sincos"][order][nq][nr] += numerator * sinq * cosr
        expected["cossin"][order][nq][nr] += numerator * cosq * sinr
        cosq, sinq = (cosq * cosq1 - sinq * sinq1,
                      sinq * cosq1 + cosq * sinq1)
        cosr, sinr = (cosr * cosr1 - sinr * sinr1,
                      sinr * cosr1 + cosr * sinr1)

for component, values in expected.items():
    for order, matrix in enumerate(values, 1):
        path = output_path / f"histZetaM_{component}_{order}.txt"
        actual = [[float(value) for value in line.split()]
                  for line in path.read_text(encoding="ascii").splitlines()
                  if line.strip() and not line.lstrip().startswith("#")]
        if len(actual) != nbins or any(len(row) != nbins for row in actual):
            raise SystemExit(f"{path.name}: unexpected matrix dimensions")
        for i in range(nbins):
            for j in range(nbins):
                got = actual[i][j]
                want = matrix[i][j]
                if not math.isclose(got, want, rel_tol=8.0e-8, abs_tol=8.0e-9):
                    raise SystemExit(
                        f"{path.name}[{i},{j}]: {got:.17g} != {want:.17g}")

        normalized_file = normalized_path / path.name
        normalized = [[float(value) for value in line.split()]
                      for line in normalized_file.read_text(
                          encoding="ascii").splitlines()
                      if line.strip() and not line.lstrip().startswith("#")]
        for i in range(nbins):
            for j in range(nbins):
                want = (matrix[i][j] / denominator[i][j]
                        if denominator[i][j] != 0.0 else 0.0)
                got = normalized[i][j]
                if not math.isclose(got, want,
                                    rel_tol=8.0e-8, abs_tol=8.0e-9):
                    raise SystemExit(
                        f"normalized {path.name}[{i},{j}]: "
                        f"{got:.17g} != {want:.17g}")
PY

# Cross-catalog mode uses catalog 1 only as the pivot and unordered pairs from
# catalog 2.  Exercise that distinct task decomposition independently.
run_cross()
{
    local name=$1
    local threads=$2
    local output="$TMP_ROOT/$name"

    mkdir -p "$output"
    "$CBALLS" \
        search="$ENGINE" \
        in="$TMP_ROOT/pivots.txt,$TMP_ROOT/legs.txt" \
        infmt=multi-columns-ascii,multi-columns-ascii \
        columns=1,2,3,4 \
        iCatalogs=1,2 \
        rootDir="$output" \
        numberThreads="$threads" \
        usePeriodic=false \
        useLogHist=false \
        rangeN=1.4 \
        rminHist=0.02 \
        sizeHistN=5 \
        mChebyshev=3 \
        nsmooth=2 \
        theta=1 \
        stepState=1000000 \
        verbose=1 \
        verbose_log=0 \
        options="$exact_options" >"$output/run.log" 2>&1 \
        || fail_with_log "$name failed" "$output/run.log"
}

run_cross cross-one 1
run_cross cross-many "$MULTI_THREADS"
for component in cos sin sincos cossin; do
    for order in 1 2 3 4; do
        name="histZetaM_${component}_${order}.txt"
        cmp -s "$TMP_ROOT/cross-one/$name" "$TMP_ROOT/cross-many/$name" \
            || fail_with_log \
                "cross 3PCF differs between thread counts: $name" \
                "$TMP_ROOT/cross-many/run.log"
    done
done

"$PYTHON" - "$TMP_ROOT/pivots.txt" "$TMP_ROOT/legs.txt" \
              "$TMP_ROOT/cross-one" <<'PY'
import itertools
import math
import pathlib
import sys

def catalog(path):
    return [tuple(map(float, line.split()))
            for line in pathlib.Path(path).read_text(encoding="ascii").splitlines()
            if line.strip()]

pivots = catalog(sys.argv[1])
legs = catalog(sys.argv[2])
output = pathlib.Path(sys.argv[3])
rmin = 0.02
rmax = 1.4
nbins = 5
orders = 4
width = (rmax - rmin) / nbins
expected = {name: [[[0.0 for _ in range(nbins)] for _ in range(nbins)]
                   for _ in range(orders)]
            for name in ("cos", "sin", "sincos", "cossin")}

def polar(pivot, neighbor):
    def dot(a, b):
        return sum(x*y for x, y in zip(a, b))
    def cross(a, b):
        return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2],
                a[0]*b[1]-a[1]*b[0])
    dr = tuple(pivot[i]-neighbor[i] for i in range(3))
    distance = math.sqrt(dot(dr, dr))
    radius = math.sqrt(dot(pivot, pivot))
    if not radius or not distance:
        return None
    normal = tuple(x/radius for x in pivot)
    axis = min(range(3), key=lambda i: abs(normal[i]))
    first = tuple((1.0 if i == axis else 0.0)-normal[axis]*normal[i]
                  for i in range(3))
    length = math.sqrt(dot(first, first))
    first = tuple(x/length for x in first)
    second = cross(first, normal)
    cosine, sine = -dot(dr, first), -dot(dr, second)
    length = math.hypot(cosine, sine)
    if length <= 1e-14*distance:
        return None
    return distance, cosine/length, sine/length

def radial_bin(distance):
    if not rmin < distance < rmax:
        return None
    index = int((distance - rmin) / width)
    return index if 0 <= index < nbins else None

for pivot in pivots:
    for j, k in itertools.combinations(range(len(legs)), 2):
        for iq, ir in ((j, k), (k, j)):
            q = legs[iq]
            r = legs[ir]
            polar_q = polar(pivot[:3], q[:3])
            polar_r = polar(pivot[:3], r[:3])
            if polar_q is None or polar_r is None:
                continue
            dq, cosq1, sinq1 = polar_q
            dr, cosr1, sinr1 = polar_r
            nq = radial_bin(dq)
            nr = radial_bin(dr)
            if nq is None or nr is None:
                continue
            numerator = pivot[3] * q[3] * r[3]
            cosq = cosr = 1.0
            sinq = sinr = 0.0
            for order in range(orders):
                expected["cos"][order][nq][nr] += numerator * cosq * cosr
                expected["sin"][order][nq][nr] += numerator * sinq * sinr
                expected["sincos"][order][nq][nr] += numerator * sinq * cosr
                expected["cossin"][order][nq][nr] += numerator * cosq * sinr
                cosq, sinq = (cosq * cosq1 - sinq * sinq1,
                              sinq * cosq1 + cosq * sinq1)
                cosr, sinr = (cosr * cosr1 - sinr * sinr1,
                              sinr * cosr1 + cosr * sinr1)

for component, values in expected.items():
    for order, matrix in enumerate(values, 1):
        path = output / f"histZetaM_{component}_{order}.txt"
        actual = [[float(value) for value in line.split()]
                  for line in path.read_text(encoding="ascii").splitlines()
                  if line.strip() and not line.lstrip().startswith("#")]
        for i in range(nbins):
            for j in range(nbins):
                if not math.isclose(actual[i][j], matrix[i][j],
                                    rel_tol=8.0e-8, abs_tol=8.0e-9):
                    raise SystemExit(
                        f"{path.name}[{i},{j}]: "
                        f"{actual[i][j]:.17g} != {matrix[i][j]:.17g}")
PY

# The aggregate run is intentionally larger. It verifies that cells are
# actually accepted and that changing only the worker count is bit-repeatable.
run_auto aggregate-one 1 "$aggregate_options" "$TMP_ROOT/aggregate.txt" 8 4
run_auto aggregate-many "$MULTI_THREADS" "$aggregate_options" \
         "$TMP_ROOT/aggregate.txt" 8 4
for component in cos sin sincos cossin; do
    for order in 1 2 3 4; do
        name="histZetaM_${component}_${order}.txt"
        cmp -s "$TMP_ROOT/aggregate-one/$name" "$TMP_ROOT/aggregate-many/$name" \
            || fail_with_log \
                "aggregate 3PCF differs between thread counts: $name" \
                "$TMP_ROOT/aggregate-many/run.log"
    done
done

cell_orientations=$(sed -n \
    's/.*accepted cell orientations = \([0-9][0-9]*\).*/\1/p' \
    "$TMP_ROOT/aggregate-many/run.log" | tail -1)
[ "${cell_orientations:-0}" -gt 0 ] \
    || fail_with_log "the triple-node traversal did not accept a cell orientation" \
                     "$TMP_ROOT/aggregate-many/run.log"

echo "PASS: $ENGINE auto/cross 3PCF oracle, aggregation, and determinism"
