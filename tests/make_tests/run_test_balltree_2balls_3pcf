#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

CBALLS=${CBALLS:-../cballs}
PYTHON=${PYTHON:-python3}
MULTI_THREADS=${MULTI_THREADS:-4}
ENGINE=${ENGINE:-balltree-2balls-omp_3pcf}
ENGINE_MACRO=${ENGINE_MACRO:-BALLTREE2BALLSOMP3PCF}
TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/ctreeballs-2balls-3pcf.XXXXXX")
trap 'rm -rf "$TMP_ROOT"' EXIT

fail_with_log()
{
    local message=$1
    local logfile=${2:-/dev/null}

    echo "ERROR: $message" >&2
    [ ! -f "$logfile" ] || cat "$logfile" >&2
    exit 1
}

build_env=$(cd .. && make --no-print-directory -s print-cyballs-build-env)
grep -q -- "-D${ENGINE_MACRO}\\([[:space:]]\\|$\\)" <<<"$build_env" \
    || fail_with_log "the active build does not enable $ENGINE_MACRO"
if ! grep -q -- '-DTHREEPCFCONVERGENCE\([[:space:]]\|$\)' <<<"$build_env"; then
    echo "SKIP: $ENGINE 3PCF is disabled (TPCFON=0)"
    exit 0
fi

"$PYTHON" - "$TMP_ROOT/auto.txt" "$TMP_ROOT/pivots.txt" \
              "$TMP_ROOT/legs.txt" "$TMP_ROOT/aggregate.txt" <<'PY'
import math
import pathlib
import sys

auto_path, pivots_path, legs_path, aggregate_path = map(pathlib.Path, sys.argv[1:])

auto = [
    (0.11, 0.23, 0.37, 0.70),
    (0.28, 0.16, 0.49, -0.35),
    (0.44, 0.31, 0.19, 1.10),
    (0.63, 0.12, 0.42, 0.25),
    (0.77, 0.39, 0.28, -0.80),
    (0.19, 0.58, 0.53, 0.55),
    (0.36, 0.72, 0.14, 1.25),
    (0.54, 0.64, 0.67, -0.45),
    (0.82, 0.79, 0.46, 0.95),
    (0.25, 0.87, 0.75, -0.20),
    (0.69, 0.91, 0.82, 0.40),
]
pivots = auto[:5]
legs = auto[4:]

def write(path, rows):
    path.write_text(
        "".join(" ".join(f"{value:.17g}" for value in row) + "\n"
                for row in rows),
        encoding="ascii",
    )

write(auto_path, auto)
write(pivots_path, pivots)
write(legs_path, legs)

aggregate = []
for i in range(384):
    angle = 0.173 * i
    radius = 0.15 + 0.0015 * (i % 71)
    x = 0.55 + radius * math.cos(angle) + 0.0007 * (i % 5)
    y = 0.48 + radius * math.sin(angle) + 0.0009 * (i % 7)
    z = 0.25 + 0.003 * (i % 83)
    field = 0.4 + 0.02 * (i % 13)
    aggregate.append((x, y, z, field))
write(aggregate_path, aggregate)
PY

run_auto()
{
    local name=$1
    local threads=$2
    local options=$3
    local catalog=${4:-$TMP_ROOT/auto.txt}
    local nsmooth=${5:-2}
    local theta=${6:-1}
    local output="$TMP_ROOT/$name"

    mkdir -p "$output"
    "$CBALLS" \
        search="$ENGINE" \
        in="$catalog" \
        infmt=multi-columns-ascii \
        columns=1,2,3,4 \
        iCatalogs=1 \
        rootDir="$output" \
        numberThreads="$threads" \
        usePeriodic=false \
        useLogHist=false \
        rangeN=1.4 \
        rminHist=0.02 \
        sizeHistN=5 \
        mChebyshev=3 \
        nsmooth="$nsmooth" \
        theta="$theta" \
        stepState=1000000 \
        verbose=1 \
        verbose_log=0 \
        options="$options" >"$output/run.log" 2>&1 \
        || fail_with_log "$name failed" "$output/run.log"
}

exact_options=pos-and-convergence,KKKCorrelation,only-3pcf,no-two-balls,no-normalize-HistZeta,out-m-HistZeta
normalized_options=pos-and-convergence,KKKCorrelation,only-3pcf,no-two-balls,out-m-HistZeta
aggregate_options=pos-and-convergence,KKKCorrelation,only-3pcf,no-normalize-HistZeta,out-m-HistZeta
run_auto exact-one 1 "$exact_options"
run_auto exact-many "$MULTI_THREADS" "$exact_options"
run_auto exact-direct 1 "$exact_options,treecorr-direct-triples"
run_auto exact-normalized 1 "$normalized_options"
run_auto exact-normalized-direct 1 "$normalized_options,treecorr-direct-triples"
run_auto theta-limit 1 "$aggregate_options" "$TMP_ROOT/auto.txt" 2 1e-12

for component in cos sin sincos cossin; do
    for order in 1 2 3 4; do
        name="histZetaM_${component}_${order}.txt"
        cmp -s "$TMP_ROOT/exact-one/$name" "$TMP_ROOT/exact-many/$name" \
            || fail_with_log \
                "exact 3PCF differs between thread counts: $name" \
                "$TMP_ROOT/exact-many/run.log"
    done
done

"$PYTHON" - "$TMP_ROOT/exact-one" \
              "$TMP_ROOT/exact-direct" "$TMP_ROOT/theta-limit" <<'PY'
import math
import pathlib
import sys

factorized = pathlib.Path(sys.argv[1])
candidates = (
    (pathlib.Path(sys.argv[2]), "direct-triple exact mode"),
    (pathlib.Path(sys.argv[3]), "theta-limit production mode"),
)
for candidate, label in candidates:
    for component in ("cos", "sin", "sincos", "cossin"):
        for order in range(1, 5):
            name = f"histZetaM_{component}_{order}.txt"
            left = [float(value)
                    for line in (factorized / name).read_text().splitlines()
                    if line.strip() and not line.lstrip().startswith("#")
                    for value in line.split()]
            right = [float(value)
                     for line in (candidate / name).read_text().splitlines()
                     if line.strip() and not line.lstrip().startswith("#")
                     for value in line.split()]
            if len(left) != len(right) or any(
                    not math.isclose(a, b, rel_tol=2.0e-12, abs_tol=2.0e-13)
                    for a, b in zip(left, right)):
                raise SystemExit(
                    f"LogMultipole exact mode and {label} differ: {name}")
PY

