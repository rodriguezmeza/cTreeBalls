#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

CBALLS=${CBALLS:-../cballs}
PYTHON=${PYTHON:-python3}
MPIEXEC=${MPIEXEC:-mpiexec}
MPIEXEC_ARGS=${MPIEXEC_ARGS:-}
MPI_RANKS=${MPI_RANKS:-2}
MPI_THREADS=${MPI_THREADS:-2}
TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/ctreeballs-kdtree-mpi.XXXXXX")
trap 'rm -rf "$TMP_ROOT"' EXIT

mpi_command=("$MPIEXEC")
if [ -n "$MPIEXEC_ARGS" ]; then
    mpi_extra_args=()
    read -r -a mpi_extra_args <<<"$MPIEXEC_ARGS"
    mpi_command+=("${mpi_extra_args[@]}")
fi

fail_with_log()
{
    local message=$1
    local logfile=${2:-/dev/null}
    echo "ERROR: $message" >&2
    [ ! -f "$logfile" ] || cat "$logfile" >&2
    exit 1
}

build_env=$(cd .. && make --no-print-directory -s KDTREEMPION=1 print-cyballs-build-env)
grep -q -- '-DKDTREEMPI\([[:space:]]\|$\)' <<<"$build_env" || fail_with_log "the active build does not enable KDTREEMPI"
grep -q -- '-DKDTREEOMP\([[:space:]]\|$\)' <<<"$build_env" || fail_with_log "the OpenMP reference engine is not enabled"

run_case()
{
    local name=$1
    local method=$2
    local ranks=$3
    local threads=$4
    local profile=$5
    local output="$TMP_ROOT/$name"
    local options="KKKCorrelation,compute-HistN,out-m-HistZeta,no-one-ball,no-smooth-pivot"
    local -a command

    if [ "$profile" = "2pcf" ]; then
        options+=",only-2pcf"
    elif [ "$profile" = "3pcf" ]; then
        options+=",only-3pcf"
    fi

    mkdir -p "$output"
    command=("$CBALLS"
        search="$method"
        testmodel=simple-cubic-random
        nbody=256
        lengthBox=2
        rootDir="$output"
        numberThreads="$threads"
        usePeriodic=false
        useLogHist=false
        rangeN=0.4
        rminHist=0.005
        sizeHistN=4
        mChebyshev=2
        nsmooth=8
        seed=123
        stepState=1000000
        verbose=1
        verbose_log=0
        "options=$options")

    if [ "$ranks" -gt 1 ]; then
        "${mpi_command[@]}" -n "$ranks" "${command[@]}" >"$output/run.log" 2>&1 || fail_with_log "$name failed" "$output/run.log"
    else
        "${command[@]}" >"$output/run.log" 2>&1 || fail_with_log "$name failed" "$output/run.log"
    fi
}

compare_numeric_outputs()
{
    "$PYTHON" - "$1" "$2" <<'PY'
import math
import pathlib
import sys

reference = pathlib.Path(sys.argv[1])
candidate = pathlib.Path(sys.argv[2])
ignore = {"parameters_null-cballs-usedvalues", "run.log"}

def result_names(directory):
    return sorted(path.name for path in directory.iterdir()
                  if path.is_file() and path.name not in ignore)

names = result_names(reference)
if not names or names != result_names(candidate):
    raise SystemExit("histogram output sets differ")

for name in names:
    def values(path):
        tokens = []
        for line in path.read_text().splitlines():
            tokens.extend(line.split("#", 1)[0].split())
        return tokens

    left = values(reference / name)
    right = values(candidate / name)
    if len(left) != len(right):
        raise SystemExit(f"{name}: value counts differ")
    for index, (a, b) in enumerate(zip(left, right)):
        x = float(a)
        y = float(b)
        if math.isnan(x) and math.isnan(y):
            continue
        if not math.isclose(x, y, rel_tol=5e-11, abs_tol=5e-12):
            raise SystemExit(f"{name}:{index}: {x!r} != {y!r}")
PY
}

for profile in both 2pcf 3pcf; do
    run_case "omp-$profile" kdtree-omp 1 1 "$profile"
    run_case "mpi-$profile" kdtree-mpi "$MPI_RANKS" "$MPI_THREADS" "$profile"
    compare_numeric_outputs "$TMP_ROOT/omp-$profile" "$TMP_ROOT/mpi-$profile" || fail_with_log "MPI $profile results differ from kdtree-omp" "$TMP_ROOT/mpi-$profile/run.log"
done

grep -q "kdtree-mpi: $MPI_RANKS ranks" "$TMP_ROOT/mpi-both/run.log" || fail_with_log "the requested MPI rank count was not used" "$TMP_ROOT/mpi-both/run.log"

echo "PASS: KDTREEMPI 2PCF/3PCF reductions match KDTREEOMP"
