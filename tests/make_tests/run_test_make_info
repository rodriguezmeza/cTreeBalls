#!/usr/bin/env bash

set -euo pipefail

root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cballs=${CBALLS:-"${root_dir}/cballs"}
output=$(mktemp "${TMPDIR:-/tmp}/ctreeballs-make-info.XXXXXX")
trap 'rm -f "${output}"' EXIT

set +e
"${cballs}" options=make-info >"${output}" 2>&1
status=$?
set -e

# make-info currently uses the normal startup stop path, which returns 1.
if (( status > 1 )); then
    printf 'FAIL: cballs options=make-info exited with status %d\n' "${status}" >&2
    exit 1
fi

for section in \
    '[Makefile_settings]' \
    '[Makefile_machine switches]' \
    '[addons/Makefile_addons_settings]' \
    '[Makefile_machine toolchain and resolved paths]' \
    '[effective compile-time features (enabled)]' \
    'smooth-pivot policy:' \
    'scan-frontier policy:' \
    'vector-log backend:'; do
    if ! grep -Fq "${section}" "${output}"; then
        printf 'FAIL: make-info is missing section %s\n' "${section}" >&2
        exit 1
    fi
done

settings=$(
    sed -nE \
        's/^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*(\?=|:=|\+=|=).*/\1/p' \
        "${root_dir}/Makefile_settings" \
        "${root_dir}/Makefile_machine" \
        "${root_dir}/addons/Makefile_addons_settings" |
    sort -u
)

missing=0
while IFS= read -r name; do
    case "${name}" in
        BUILD_*|*_PIVOT_*_SIZE|*_FRONTIER_*|*ON|_DEBUGON_|DEFDIMENSION|USEGSL|GSLINTERNAL|OPENMPMACHINE|THETA|ALLOW_BALLS_WITH_SMOOTHING|DEFINEFLAGS|PROJECT_WARNING_FLAGS|SANITIZER_FLAGS|*_MACOSX_DEPLOYMENT_TARGET)
            if ! grep -Eq "^[[:space:]]+${name}[[:space:]]+=" "${output}"; then
                printf 'FAIL: make-info does not publish %s\n' "${name}" >&2
                missing=1
            fi
            ;;
    esac
done <<<"${settings}"

if (( missing != 0 )); then
    exit 1
fi

if ! grep -Eq '^[[:space:]]+SLEEF_ENABLED[[:space:]]+= [01]$' "${output}"; then
    printf 'FAIL: make-info did not publish a resolved SLEEF_ENABLED value\n' >&2
    exit 1
fi

if grep -Eq '^[[:space:]]+BALLTREE2BALLSOMPON[[:space:]]+= 1$' "${output}"; then
    for expected in \
        'balltree-2balls-omp tree policy:' \
        'two-entry content-keyed compact-tree cache' \
        'balltree-2balls-omp 3PCF policy:' \
        'no-balltree-persistent-frontier'; do
        if ! grep -Fq -- "${expected}" "${output}"; then
            printf 'FAIL: make-info is missing ball-tree policy text: %s\n' \
                "${expected}" >&2
            exit 1
        fi
    done
fi

if [[ -n "${EXPECTED_SINGLEPON:-}" ]] &&
   ! grep -Eq "^[[:space:]]+SINGLEPON[[:space:]]+= ${EXPECTED_SINGLEPON}$" "${output}"; then
    printf 'FAIL: make-info does not report SINGLEPON=%s\n' \
        "${EXPECTED_SINGLEPON}" >&2
    exit 1
fi

smooth_setting=$(sed -nE \
    's/^[[:space:]]+SMOOTHPIVOTON[[:space:]]+= ([01])$/\1/p' "${output}")
if [[ "${smooth_setting}" == 1 ]]; then
    for expected in \
        'smooth-pivot policy: compiled=yes' \
        'default=enabled' \
        'opt-out=options=no-smooth-pivot' \
        'octree-sincos-omp' \
        'kdtree-2balls-omp' \
        'kdtree-2balls-mpi' \
        'balltree-shear-sphere-2balls-omp'; do
        if ! grep -Fq -- "${expected}" "${output}"; then
            printf 'FAIL: enabled smooth-pivot policy is missing: %s\n' \
                "${expected}" >&2
            exit 1
        fi
    done
elif [[ "${smooth_setting}" == 0 ]]; then
    if ! grep -Fq -- \
        'smooth-pivot policy: compiled=no; supported engines=none; default=disabled' \
        "${output}"; then
        printf 'FAIL: disabled smooth-pivot policy is inconsistent\n' >&2
        exit 1
    fi
else
    printf 'FAIL: make-info did not publish a parseable SMOOTHPIVOTON value\n' >&2
    exit 1
fi

printf 'PASS: make-info publishes every configurable Make switch.\n'
