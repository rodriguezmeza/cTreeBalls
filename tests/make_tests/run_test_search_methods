#!/usr/bin/env bash

set -euo pipefail

root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cballs=${CBALLS:-"${root_dir}/cballs"}
methods_output=$(mktemp "${TMPDIR:-/tmp}/ctreeballs-search-methods.XXXXXX")
options_output=$(mktemp "${TMPDIR:-/tmp}/ctreeballs-options.XXXXXX")
make_output=$(mktemp "${TMPDIR:-/tmp}/ctreeballs-make-info.XXXXXX")
trap 'rm -f "${methods_output}" "${options_output}" "${make_output}"' EXIT

run_help() {
    local argument=$1
    local output=$2
    local status
    set +e
    "${cballs}" "options=${argument}" >"${output}" 2>&1
    status=$?
    set -e
    if (( status > 1 )); then
        printf 'FAIL: options=%s returned status %s\n' "${argument}" "${status}" >&2
        exit 1
    fi
}

run_help print-search-methods "${methods_output}"
run_help print-options "${options_output}"
run_help make-info "${make_output}"

for expected in \
    'Searching methods registered in this executable' \
    'Only methods enabled by this executable' \
    'Select one with search=<name>' \
    'tests/python/kappa_corr_all_engines.py reuses one in-memory catalog' \
    'tests/python/shear_corr_all_engines.py' \
    'tests/python/lya_corr_all_engines.py'; do
    grep -Fq -- "${expected}" "${methods_output}" || {
        printf 'FAIL: search-method help is missing: %s\n' "${expected}" >&2
        exit 1
    }
done

active_methods=(
    octree-sincos-omp
    kdtree-2balls-omp kdtree-2balls-mpi
    balltree-2balls-omp balltree-2balls-mpi
    octree-2balls-omp octree-2balls-mpi
    octree-shear-sphere-2balls-omp
    kdtree-shear-sphere-2balls-omp
    balltree-shear-sphere-2balls-omp
    kdtree-box-omp neighbor-boxes-omp
    octree-3pcf-3d-omp octree-3pcf-3d-mpi
    lya-2pcf-omp lya-3pcf-omp lya-2pcf-3pcf-omp
    lya-los-tree-2pcf-omp lya-los-tree-3pcf-omp lya-los-tree-2pcf-3pcf-omp
    lya-1d-2pcf-omp lya-1d-3pcf-omp lya-1d-2pcf-3pcf-omp
    lya-1d-tree-2pcf-omp lya-1d-tree-same-los-2pcf-omp
    lya-1d-tree-3pcf-omp
    lya-2pcf-mpi lya-3pcf-mpi lya-2pcf-3pcf-mpi
    lya-1d-2pcf-mpi lya-1d-3pcf-mpi lya-1d-2pcf-3pcf-mpi
    lya-1d-tree-2pcf-mpi lya-1d-tree-3pcf-mpi
)

for method in "${active_methods[@]}"; do
    grep -Fq -- "- ${method} (id=" "${methods_output}" || {
        printf 'FAIL: active method is missing: %s\n' "${method}" >&2
        exit 1
    }
done

inactive_methods=(
    balls-omp kdtree-omp kdtree-mpi
    balltree-omp balltree-mpi octree-ggg-omp octree-ggg-mpi
    octree-balls4-omp octree-balls4-mpi octree-shear-omp
    octree-shear-sphere-omp balltree-2balls-omp_3pcf
    balltree-2balls-mpi_3pcf
)
for method in "${inactive_methods[@]}"; do
    if grep -Fq -- "- ${method} (id=" "${methods_output}"; then
        printf 'FAIL: disabled public method was advertised: %s\n' "${method}" >&2
        exit 1
    fi
done

method_names=$(sed -nE 's/^- ([^ ]+) \(id=[0-9]+\)$/\1/p' "${methods_output}")
if [[ $(printf '%s\n' "${method_names}" | sed '/^$/d' | wc -l | tr -d ' ') \
      != ${#active_methods[@]} ]]; then
    printf 'FAIL: registered method count does not match the active profile\n' >&2
    exit 1
fi
if [[ $(printf '%s\n' "${method_names}" | sort | uniq -d | wc -l | tr -d ' ') != 0 ]]; then
    printf 'FAIL: duplicate search methods were printed\n' >&2
    exit 1
fi

smooth_count=$(grep -c '^  smooth-pivot:' "${methods_output}" || true)
if [[ "${smooth_count}" != ${#active_methods[@]} ]]; then
    printf 'FAIL: each active method needs one smooth-pivot policy\n' >&2
    exit 1
fi

option_names=$(sed -nE 's/^- ([^ ]+) \[[^]]+\]:.*/\1/p' "${options_output}")
if [[ -z "${option_names}" ]]; then
    printf 'FAIL: print-options emitted no parseable options\n' >&2
    exit 1
fi
if [[ $(printf '%s\n' "${option_names}" | sort | uniq -d | wc -l | tr -d ' ') != 0 ]]; then
    printf 'FAIL: print-options contains duplicate names\n' >&2
    exit 1
fi

for option in print-search-methods make-info smooth-pivot no-smooth-pivot \
    legacy-one-ball read-mask edge-corrections only-2pcf only-3pcf \
    compute-2pcf-3d compute-3pcf-3d survey-estimator-3d \
    exclude-same-los exclude-all-same-los dual-node-bin-slop \
    dual-node-direct-triples dual-node-bucket-leaves \
    dual-node-singleton-leaves dual-node-profile no-balltree-tree-cache \
    no-balltree-persistent-frontier no-balltree-parallel-build weights-norm; do
    grep -Fq -- "- ${option} [" "${options_output}" || {
        printf 'FAIL: active option is missing: %s\n' "${option}" >&2
        exit 1
    }
done

for option in behavior-tree-omp compute-j-no-eq-i pivot-loop default-rsmooth \
    fix-rsmooth edge-effects no-two-ball set-default-param set-Nb-noSel \
    smooth smooth-min-cell; do
    grep -Fq -- "- ${option} [" "${options_output}" || {
        printf 'FAIL: cached legacy option is missing: %s\n' "${option}" >&2
        exit 1
    }
done

for expected in \
    'balltree-2balls-omp tree policy:' \
    'two-entry content-keyed compact-tree cache' \
    'bounded sparse unresolved-node frontier' \
    'vector-log backend:'; do
    grep -Fq -- "${expected}" "${make_output}" || {
        printf 'FAIL: make-info is missing runtime policy: %s\n' "${expected}" >&2
        exit 1
    }
done

grep -Eq '^[[:space:]]+SLEEF_ENABLED[[:space:]]+= [01]$' "${make_output}" || {
    printf 'FAIL: make-info is missing resolved SLEEF_ENABLED state\n' >&2
    exit 1
}

for setting in KDTREE2BALLSOMPON KDTREE2BALLSMPION BALLTREE2BALLSOMPON \
    BALLTREE2BALLSMPION OCTREE2BALLSOMPON OCTREE2BALLSMPION LYAFORESTOMPON \
    LYAFORESTMPION OCTREESHEARSPHERE2BALLSOMPON \
    KDTREESHEARSPHERE2BALLSOMPON BALLTREESHEARSPHERE2BALLSOMPON \
    KDTREEBOXOMPON NEIGHBORBOXESOMPON OCTREE3PCF3DOMPON OCTREE3PCF3DMPION; do
    grep -Eq "^[[:space:]]+${setting}[[:space:]]+= 1$" "${make_output}" || {
        printf 'FAIL: make-info is missing active setting: %s\n' "${setting}" >&2
        exit 1
    }
done

for setting in KDTREEOMPON KDTREEMPION BALLTREEOMPON BALLTREEMPION \
    OCTREEGGGOMPON OCTREEGGGMPION OCTREEBALLS4OMPON OCTREEBALLS4MPION; do
    if grep -Eq "^[[:space:]]+${setting}[[:space:]]+= 1$" "${make_output}"; then
        printf 'FAIL: make-info published an inactive addon as enabled: %s\n' \
            "${setting}" >&2
        exit 1
    fi
done

printf 'PASS: runtime help matches the active addon profile.\n'
