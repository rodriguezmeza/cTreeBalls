#!/usr/bin/env bash
set -euo pipefail

#CBALLS=${CBALLS:-../cballs_sincos}
CBALLS=${CBALLS:-../cballs}
OUT=${OUT:-Output_smoke_balls_omp}

cd "$(dirname "$0")"

rm -rf "$OUT"

LOG="$OUT.run.log"

set +e
"$CBALLS" \
  search=balls-omp \
  rootDir="$OUT" \
  options=compute-HistN,out-m-HistZeta \
  testmodel=unit-sphere-random \
  nbody=2000 \
  rangeN=0.0633205 \
  rminHist=0.00213811 \
  sizeHistN=12 \
  mChebyshev=3 \
  sizeHistPhi=16 \
  useLogHist=true \
  usePeriodic=false \
  stepState=1000 \
  numberThreads=2 \
  verbose=1 \
  verbose_log=1 >"$LOG" 2>&1
status=$?
set -e

if [ "$status" -ne 0 ]; then
  if grep -q "searchMethod 'balls-omp' is not available" "$LOG"; then
    cat "$LOG"
    echo "SKIP: balls-omp is not compiled in this executable"
    exit 77
  fi
  cat "$LOG"
  exit "$status"
fi

cat "$LOG"
python ./scripts/check_smoke_balls_omp.py "$OUT"
