MDIR := $(shell pwd)

# Keep precision profiles in separate object directories.  Command-line
# overrides such as `make SINGLEPON=1 cballs` take precedence over this default.
#SINGLEPON ?= 0
SINGLEPON ?= 0

ifeq ($(ADDONSON),1)
ifndef CTREEBALLS_ADDONS_SETTINGS_INCLUDED
CTREEBALLS_ADDONS_SETTINGS_INCLUDED := 1
include $(MACHINES_DIR)/addons/Makefile_addons_settings
endif
endif


BUILD_CLASSLIB := noclasslib
ifeq ($(CLASSLIBON),1)
BUILD_CLASSLIB := classlib
endif

BUILD_OPENMP := noopenmp
ifeq ($(OPENMPMACHINE),1)
BUILD_OPENMP := openmp
endif

BUILD_ADDONS := noaddons
ifeq ($(ADDONSON),1)
BUILD_ADDONS := addons
endif

BUILD_MPI := nompi
ifneq ($(filter 1,$(BALLTREEMPION) $(BALLTREE2BALLSMPION) $(OCTREE2BALLSMPION) $(BALLTREE2BALLSMPI3PCFON) $(OCTREEGGGMPION) $(OCTREEBALLS4MPION) $(LYAFORESTMPION) $(OCTREE3PCF3DMPION)),)
BUILD_MPI := mpi
endif

BUILD_LYA := nolya
ifneq ($(filter 1,$(LYAFORESTOMPON) $(LYAFORESTMPION)),)
BUILD_LYA := lya
endif

BUILD_SHEAR := noshear
ifeq ($(OCTREESHEAROMPON),1)
BUILD_SHEAR := shear
endif

BUILD_PRECISION := double
ifeq ($(SINGLEPON),1)
BUILD_PRECISION := mixed
endif

WRKDIR = $(MDIR)/build/$(BUILD_ADDONS)-$(BUILD_CLASSLIB)-$(BUILD_OPENMP)-$(BUILD_MPI)-$(BUILD_LYA)-$(BUILD_SHEAR)-$(BUILD_PRECISION)

.base:
	mkdir -p $(WRKDIR)/lib
	touch $(WRKDIR)/.base

vpath %.c $(MDIR)/source:$(MDIR)/general_libs:$(MDIR)/getparam:$(MDIR)/main
vpath %.o $(WRKDIR)
vpath .base $(WRKDIR)


#B LINES TO ADAPT TO YOUR PLATFORM
#
#--------------------------------------------
# Set other local options to this code
# 	INCLUDES :: OPT1
# 	OTHER OPTIONS :: OPT2
# Some of this definitions can be set in a particular machine
#
OPT1 =
#
# This variable is to show settings
#   and set the corresponding definitions to the compiler
OPT2 =
OPT2LIB =
# The one which will be used by CC is CCFLAG. At some point it gets OPT2 definitions...
#
#
#OPT1    +=  -I ./
#OPT1    +=  -I ./general_libs
# Add as many as needed
#
#OPT2   +=  -DOPTIONNAME
# Add as many as needed

#PRECISION = DOUBLEPREC

#
# your C compiler: Comment/uncomment as convenient
#
# GNU c
# default is gcc-15,
# cyballs module is working with python 3.13 and gcc-15
#   check with: 'python -c "import cyballs"'
CC       = gcc
# tested in MacBook Pro chip: Apple M3 Max
#CC       = gcc-12
#CC       = gcc-15
# With icc (Intel):
#CC       = icc
#

#
#E LINES TO ADAPT TO YOUR PLATFORM

#
# Nothing to do below. Almost... may be some compiler options should be changed
#

#
# Your python interpreter.
# In order to use Python 3, you can manually
# substitute python3 to python in the line below, or you can simply
# add a compilation option on the terminal command line:
# "PYTHON=python3 make all" (THanks to Marius Millea for pyhton3
# compatibility)
PYTHON ?= python
# tested in MacBook Pro chip: Apple M3 Max
#PYTHON = python3.12

# your optimization flag
# clang-12: warning: -O4 is equivalent to -O3 [-Wdeprecated]
#OPTFLAG = -O4 -ffast-math #-march=native
#OPTFLAG = -O3 -ffast-math #-march=native
OPTFLAG = -O3 -fno-fast-math #-march=native
#OPTFLAG = -Ofast -ffast-math #-march=native
#OPTFLAG = -fast

# your openmp flag (comment for compiling without openmp)
OMPFLAG   = -fopenmp
#OMPFLAG   = -mp -mp=nonuma -mp=allcores -g
#OMPFLAG   = -openmp

# all other compilation flags
CCFLAG = -g -fPIC
LDFLAG = -g -fPIC

# Optional focused sanitizer profile, for example:
#   make SANITIZER=address,undefined cballs
ifneq ($(strip $(SANITIZER)),)
SANITIZER_FLAGS = -fsanitize=$(SANITIZER) -fno-omit-frame-pointer
CCFLAG += $(SANITIZER_FLAGS)
LDFLAG += $(SANITIZER_FLAGS)
endif

UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
PYTHON_MACOSX_DEPLOYMENT_TARGET := $(shell $(PYTHON) -c "import sysconfig; print(sysconfig.get_config_var('MACOSX_DEPLOYMENT_TARGET') or '11.0')")
OPENMP_MACOSX_DEPLOYMENT_TARGET := $(shell runtime="$$($(CC) -print-file-name=libgomp.dylib 2>/dev/null)"; if test -f "$$runtime"; then otool -l "$$runtime" 2>/dev/null | awk '/LC_BUILD_VERSION/{found=1; next} found && /minos/{print $$2; exit}'; fi)
MACOSX_DEPLOYMENT_TARGET ?= $(shell $(PYTHON) -c "import sys; versions=[v for v in sys.argv[1:] if v]; print(max(versions, key=lambda v: tuple(map(int, v.split('.')))))" "$(PYTHON_MACOSX_DEPLOYMENT_TARGET)" "$(OPENMP_MACOSX_DEPLOYMENT_TARGET)")
export MACOSX_DEPLOYMENT_TARGET
MACOS_DEPLOYMENT_FLAG = -mmacosx-version-min=$(MACOSX_DEPLOYMENT_TARGET)
CCFLAG += $(MACOS_DEPLOYMENT_FLAG)
LDFLAG += $(MACOS_DEPLOYMENT_FLAG)
endif

# pass current working directory to the code
CCFLAG += -D__CTREEBALLSDIR__='"$(MDIR)"'

# where to find include files *.h
INCLUDES = -I$(MDIR)/include
HEADERFILES = $(wildcard ./include/*.h)

#INCLUDES += $(OPT1)

#
MLIBS = -lm
#

# your tool for creating static libraries:
AR        = ar rv

# automatically add external programs if needed. First, initialize to blank.
EXTERNAL =

#
ifeq ($(DEFDIMENSION),2)
    DIMCODE = -DTWODIMCODE
    OPT2 += $(DIMCODE)
else
    DIMCODE = -DTHREEDIMCODE
    OPT2 += $(DIMCODE)
endif
#

#
ifeq ($(OPENMPMACHINE),1)
OMPCODE = -DOPENMPCODE
OPT2 += $(OMPCODE)
MLIBS += -lgomp
endif
#


# Use float storage for search geometry and double computation/accumulation.
# Set on the command line with `make SINGLEPON=1 ...`.
#
ifeq ($(SINGLEPON),1)
SINGLEP = -DSINGLEP
OPT2 += $(SINGLEP)
endif
#

# To activate long integers set to 1. Else 0
LONGINTON = 1
#
ifeq ($(LONGINTON),1)
LONG = -DLONGINT
OPT2 += $(LONG)
endif
#

# Flags only for Mac...
MACONLYON = 0
ifeq ($(MACONLYON),1)
OPT2 += -DMACONLY
endif

#B ADDONS
#
#B Do not use any of these flags.
#   Are intended for developing and debuging purposes.
#
# To print some useful debuggin info set to 1. Else 0
#   acts also as (thoroughly )DIAGNOSTICS flag...
#   used in some engines, like search_octree_ggg_omp
DEBUGON = 0
DEBUGCOMPILINGON = 0
DEBUGTREEON = 0
DEBUGTRACKINGON = 0
#
#E
#
ifeq ($(DEBUGCOMPILINGON),1)
PROJECT_WARNING_FLAGS = -Wall -Wextra -Wpedantic -Wformat=2 \
    -Werror=format -Werror=implicit-function-declaration -Werror=return-type \
    -Wno-unused-function -Wno-unused-parameter -Wno-unused-variable \
    -Wno-unused-but-set-variable -Wno-format-truncation
endif
ifeq ($(DEBUGON),1)
OPT2 += -DDEBUG
endif
ifeq ($(DEBUGTREEON),1)
OPT2 += -DDEBUGTREE
endif
ifeq ($(DEBUGTRACKINGON),1)
OPT2 += -DDEBUGTRACKING
endif
#
ifeq ($(ADDONSON),1)
OPT2 += -DADDONS
# Machine definitions
include $(MACHINES_DIR)/addons/Makefile_addons
#
else
OPT2 += -DTPCF
endif

#E ADDONS

#
#B GENERALLIBS section
# Use 0 to get rid off all calls to general_libs routines:
# (always set to 1...)
GENERALLIBS_ON = 1

ifeq ($(GENERALLIBS_ON),1)
GENERALLIBS = general_libs
vpath %.c $(MDIR)/$(GENERALLIBS)
INCLUDES += -I$(MDIR)/$(GENERALLIBS)
HEADERFILES += $(wildcard ./general_libs/*.h)
EXTERNAL += clib.o mathfns.o inout.o mathutil.o numrec.o
endif
#
#E

#
#B GETPARAM section
# Use 0  to get rid off all calls to getparam routines:
# (always set to 1... 0 is experimental so far)
GETPARAM_ON = 1

ifeq ($(GETPARAM_ON),1)
GETPARAM = getparam
vpath %.c $(MDIR)/$(GETPARAM)
OPT2 += -DGETPARAM
INCLUDES += -I$(MDIR)/$(GETPARAM)
HEADERFILES += $(wildcard ../general_libs/*.h)
EXTERNAL += getparam.o
endif
#
#E


#---------------------------------------------
# BEGIN GSL and CFITSIO DEFINITIONS (if needed)
#

# -------------------
#B CFITSIO
# It can be necessary to export path to pkgconfig
#export PKG_CONFIG_PATH=/Users/mar/NagBody_pkg/local/cfitsio/lib/pkgconfig:$PKG_CONFIG_PATH

# CFITSIO section
ifeq ($(CFITSIOON),1)

CFITSIO_INCL =
CFITSIO_LDFLAGS =
CFITSIO_LIBS =
CFITSIO_RPATH =

ifeq ($(CFITSIOLIBON),0)

comma := ,

PKG_CONFIG ?= pkg-config
CFITSIO_PKG ?= cfitsio

# Manual override still allowed:
#   CFITSIO_INCLUDE=/path/include CFITSIO_LIB=/path/lib make all
ifneq ($(CFITSIO_INCLUDE),)
    CFITSIO_INCL = -I$(CFITSIO_INCLUDE)
else
    CFITSIO_INCL = $(shell $(PKG_CONFIG) --cflags $(CFITSIO_PKG) 2>/dev/null)
endif

ifneq ($(CFITSIO_LIB),)
    CFITSIO_LDFLAGS = -L$(CFITSIO_LIB)
    CFITSIO_LIBS = -lcfitsio
    CFITSIO_RPATH = -Wl,-rpath,$(CFITSIO_LIB)
else
    CFITSIO_LDFLAGS = $(shell $(PKG_CONFIG) --libs-only-L $(CFITSIO_PKG) 2>/dev/null)
    CFITSIO_LIBS = $(shell $(PKG_CONFIG) --libs-only-l $(CFITSIO_PKG) 2>/dev/null)
    CFITSIO_RPATH = $(patsubst -L%,-Wl$(comma)-rpath$(comma)%,$(CFITSIO_LDFLAGS))
endif

CCFLAG += $(CFITSIO_INCL)
LDFLAG += $(CFITSIO_LDFLAGS) $(CFITSIO_RPATH)
FITSIOLIBS += $(CFITSIO_LIBS)

endif # CFITSIOLIBON=0

endif # CFITSIOON=1

#E new CFITSIO
# -------------------

# ---------------------------------------------
#B GSL DEFINITIONS
##
## Definition to set where GSL are located
##
## Experiment using this lib... apparently is for interfacing with C++
##   therefore look for something similar for C.
##    -L/usr/local/lib/ -lboost_python312
##
#
#
ifeq ($(USEGSL),1)

OPT2 += -DUSEGSL
ifeq ($(GSLINTERNAL),0)

GSL_CONFIG ?= gsl-config

# Allow user override:
#   GSL_INCLUDE=/path/include GSL_LIB=/path/lib make all
ifneq ($(GSL_INCLUDE),)
    GSL_CFLAGS = -I$(GSL_INCLUDE)
else
    GSL_CFLAGS = $(shell $(GSL_CONFIG) --cflags 2>/dev/null)
endif

ifneq ($(GSL_LIB),)
    GSL_LDFLAGS = -L$(GSL_LIB)
    GSL_LIBS = -lgsl -lgslcblas
else
    GSL_LDFLAGS =
    GSL_LIBS = $(shell $(GSL_CONFIG) --libs 2>/dev/null)
endif

CCFLAG += $(GSL_CFLAGS)
LDFLAG += $(GSL_LDFLAGS)
MLIBS += $(GSL_LIBS)

    CCFLAG += -DNOINTERNALGSL

endif # ! GSLINTERNAL

ifeq ($(GSLINTERNAL),1)
include $(MACHINES_DIR)/addons/Makefile_gsl
endif # ! GSLINTERNAL

endif # ! USEGSL
#endif
