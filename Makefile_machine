# Capture the final Make settings in the executable.  Keeping this metadata in
# a generated header preserves strings containing spaces (compiler flags,
# include paths, and linker flags) without fragile command-line quoting.
CBALLS_MAKE_INFO_HEADER := $(WRKDIR)/cballs_make_info.h
CBALLS_MAKE_INFO_GENERATOR := $(MDIR)/scripts/generate_make_info_header.sh
INCLUDES += -I$(WRKDIR)
HEADERFILES += $(CBALLS_MAKE_INFO_HEADER)

CBALLS_MAKE_INFO_VARIABLES := \
	DEFDIMENSION USEGSL GSLINTERNAL OPENMPMACHINE ADDONSON \
	SINGLEPON LONGINTON MACONLYON DEBUGON DEBUGCOMPILINGON DEBUGTREEON \
	DEBUGTRACKINGON GENERALLIBS_ON GETPARAM_ON \
	OCTREEGGGOMPON KDTREEOMPON BALLTREEOMPON BALLTREE2BALLSOMPON \
	BALLTREE2BALLSMPION \
	OCTREE2BALLSOMPON OCTREE2BALLSMPION \
	BALLTREE2BALLSOMP3PCFON BALLTREE2BALLSMPI3PCFON BALLTREEMPION \
	OCTREEGGGMPION GGG_OMP_PIVOT_CHUNK_SIZE GGG_MPI_PIVOT_CLAIM_SIZE \
	LYAFORESTOMPON LYAFORESTMPION LYA1D_OMP_PIVOT_BLOCK_SIZE \
	OCTREESHEAROMPON KDTREEBOXOMPON \
	NEIGHBORBOXESOMPON GADGETIOON CLASSLIBON PXDON IOLIBON \
	CFITSIOLIBON CFITSIOON SMOOTHPIVOTON NOWKAvgON NMultipolesON \
	NONORMHISTON POLARAXISON NOLIMBERON OVERCOUNTINGON \
	NOSTANDARNORMHISTON CMDLINE_DEFS_UNITSPHERE_ON TWOPCFON TPCFON \
	TPCFSHEARON PRUNEON BALLS4SCANLEVON THETA NORMALHISTSCALEON \
	_DEBUGON_ LOGBINON ORIGINALCBON ADDPIVOTNEIGHBOURSON \
	OCTREE3PCF3DOMPON OCTREE3PCF3DMPION CB3D_OMP_PIVOT_BLOCK_SIZE \
	OCTREESMOOTHINGON OCTREEKKKOMPON BALLSON \
	BALLS0357ON ALLOW_BALLS_WITH_SMOOTHING OCTREEBALLS4OMPON OCTREEBALLS4MPION \
	OCTREEGGGCROSSOMPON DIRECTMETHODON OCTREEGGGON \
	DIRECTMETHODSIMPLEON DIRECTMETHODSIMPLELOOPIDON COMPLEXLIBON \
	OCTREEGGGOMPTRIANGLESON OCTREEBOXOMPON KDTREECUTEBOXON \
	OCTREEKKKBALLS4OMPTRIANGLESON COSMOLIBON SAVERESTOREON \
	TREEOMPSINCOSON OCTREESINCOSOMPON \
	MDIR WRKDIR MACHINES_DIR CC PYTHON OPTFLAG OMPFLAG OPT1 OPT2 OPT2LIB CCFLAG \
	LDFLAG INCLUDES MLIBS FITSIOLIBS EXTERNAL AR SANITIZER \
	MACOSX_DEPLOYMENT_TARGET PKG_CONFIG CFITSIO_PKG CFITSIO_INCLUDE \
	CFITSIO_LIB CFITSIO_INCL CFITSIO_LDFLAGS CFITSIO_LIBS CFITSIO_RPATH \
	GSL_CONFIG GSL_INCLUDE GSL_LIB GSL_CFLAGS GSL_LDFLAGS GSL_LIBS

CBALLS_MAKE_INFO_VARIABLES += BUILD_ADDONS BUILD_CLASSLIB BUILD_OPENMP \
	BUILD_MPI BUILD_LYA BUILD_SHEAR BUILD_PRECISION DEFINEFLAGS \
	SANITIZER_FLAGS PROJECT_WARNING_FLAGS DIMCODE OMPCODE SINGLEP LONG \
	PYTHON_MACOSX_DEPLOYMENT_TARGET OPENMP_MACOSX_DEPLOYMENT_TARGET \
	MACOS_DEPLOYMENT_FLAG GENERALLIBS GETPARAM MPICC UNAME_S

export $(CBALLS_MAKE_INFO_VARIABLES)

.PHONY: cballs-make-info-force
cballs-make-info-force:

$(CBALLS_MAKE_INFO_HEADER): cballs-make-info-force $(CBALLS_MAKE_INFO_GENERATOR) | .base
	@CBALLS_MAKE_INFO_VARIABLES='$(CBALLS_MAKE_INFO_VARIABLES)' \
		sh $(CBALLS_MAKE_INFO_GENERATOR) $@

CCFLAG += $(OPT2)

VENDORED_SOURCE_PATTERNS = $(if $(strip $(GSL)),$(GSL)/%) \
    $(if $(strip $(CFITSIO_SOURCE_DIR)),$(CFITSIO_SOURCE_DIR)/%)
SOURCE_WARNING_FLAGS = $(if $(filter $(VENDORED_SOURCE_PATTERNS),$<),-w,$(PROJECT_WARNING_FLAGS))

# Addon makefiles may replace HEADERFILES; core ABI and option headers must
# still invalidate every object that includes globaldefs.h.
%.o: %.c .base $(wildcard $(MDIR)/include/*.h) $(HEADERFILES) $(MAKEFILE_LIST)
	cd $(WRKDIR);$(CC) $(OPTFLAG) $(OMPFLAG) $(CCFLAG) $(SOURCE_WARNING_FLAGS) $(INCLUDES) -c $< -o $*.o
