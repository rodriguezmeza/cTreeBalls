# dual-node-style full-sky spin-2 estimator over an FCFC PCA ball tree.

ifeq ($(BALLTREESHEARSPHERE2BALLSOMPON),1)
OPT2 += -DBALLTREESHEARSPHERE2BALLSOMP -DTHREEPCFSHEAR -DTWOPCF \
	-DSHEAR_OMP_PIVOT_BLOCK_SIZE=$(SHEAR_OMP_PIVOT_BLOCK_SIZE)
BALLTREESHEARSPHERE2BALLSOMP = $(MDIR)/addons/balltree_shear_sphere_2balls_omp/
vpath %.c $(BALLTREESHEARSPHERE2BALLSOMP)
INCLUDES += -I$(BALLTREESHEARSPHERE2BALLSOMP) \
	-I$(MDIR)/support/shear_binary \
	-I$(MDIR)/support/spherical_shear \
	-I$(MDIR)/support/shear_kernel \
	-I$(MDIR)/support/pca_tree
HEADERFILES += $(wildcard $(BALLTREESHEARSPHERE2BALLSOMP)/*.h)
EXTERNAL += search_balltree_shear_sphere_2balls_omp.o
search_balltree_shear_sphere_2balls_omp.o: \
	$(BALLTREESHEARSPHERE2BALLSOMP)/search_balltree_shear_sphere_2balls_omp.c \
	$(MDIR)/support/shear_binary/shear_sphere_binary_scan.h \
	$(MDIR)/support/pca_tree/fcfc_balltree.h \
	$(MDIR)/support/shear_kernel/search_octree_shear_omp.c
endif
