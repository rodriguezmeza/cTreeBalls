# Scalar angular correlations: OpenMP and MPI+OpenMP partners.
KDTREE2BALLSOMPON = 1
KDTREE2BALLSMPION = 1
BALLTREE2BALLSOMPON = 1
BALLTREE2BALLSMPION = 1
OCTREE2BALLSOMPON = 1
OCTREE2BALLSMPION = 1

# Ly-alpha forest methods and deterministic reduction controls.
LYAFORESTOMPON = 1
LYAFORESTMPION = 1
LYA1D_OMP_PIVOT_BLOCK_SIZE ?= 256
LYA1D_TREE3_LEAF_SIZE ?= 8

# Full-sky spin-2 OpenMP methods.
OCTREESHEARSPHERE2BALLSOMPON ?= 1
KDTREESHEARSPHERE2BALLSOMPON ?= 1
BALLTREESHEARSPHERE2BALLSOMPON ?= 1
SHEAR_OMP_PIVOT_BLOCK_SIZE ?= 32

# Periodic-box methods.
KDTREEBOXOMPON = 1
NEIGHBORBOXESOMPON = 1

# I/O and Python binding support.
GADGETIOON = 1
CLASSLIBON = 1
IOLIBON = 1
CFITSIOON = 1
ifeq ($(CLASSLIBON),1)
PXDON = 1
else
$(error PXDON requires CLASSLIBON=1)
endif

# Production numerical behavior.
SMOOTHPIVOTON = 1
NMultipolesON = 1
NONORMHISTON = 1
CMDLINE_DEFS_UNITSPHERE_ON = 1
TWOPCFON = 1
TPCFON = 1
PRUNEON = 1
BALLS4SCANLEVON = 1
THETA = 1.25
DEFINEFLAGS =
_DEBUGON_ = 0
LOGBINON = 0

# Physical 3D scalar multipoles.
OCTREE3PCF3DOMPON = 1
OCTREE3PCF3DMPION = 1
CB3D_OMP_PIVOT_BLOCK_SIZE ?= 64

