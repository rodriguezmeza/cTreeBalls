else
$(info To compile with OCTREEKKKBALLS4OMPTRIANGLES needs BALLSON = 1, deactivating...)
OCTREEKKKBALLS4OMPTRIANGLESON = 0
endif

# COSMOLIB
# For computing several cosmology functions
COSMOLIBON = 0

