#================================================================
#B Set of settings
#
#B Here switch on/off the AddOns´ modules

$(info )
$(info =====================================================)

# OCTREEGGGOMP
# For computing 3pcf using octree-ggg-omp
#   is still in development phase.
# Number of consecutive pivots accumulated before the deterministic OpenMP
# reduction.  Larger blocks reduce synchronization overhead while preserving
# the fixed reduction order used for repeatable results.
GGG_OMP_PIVOT_CHUNK_SIZE ?= 4096
ifeq ($(USEGSL),1)
OCTREEGGGOMPON = 1
else
ifeq ($(COMPLEXLIBON),1)
OCTREEGGGOMPON = 1
else
$(info To compile with OCTREEGGGOMP needs USEGSL/COMPLEXLIBON = 1, deactivating...)
# Note: COMPLEXLIB is in development phase. Don not use
#                           testing without GSL !!!!!!!!!!!!!!!!!!!!!!!
OCTREEGGGOMPON = 0
endif
endif

# KDTREEOMP
# For computing 3pcf using kdtree-omp method
KDTREEOMPON = 1

# BALLTREEOMP
# FCFC-style PCA ball tree for 2pcf and 3pcf
BALLTREEOMPON = 1

# BALLTREE2BALLSOMP
# TreeCorr-style dual-ball scan over the FCFC PCA ball tree for scalar 2pcf.
BALLTREE2BALLSOMPON = 1

# BALLTREE2BALLSMPI
# Deterministic MPI+OpenMP dual-node 2PCF and triple-node 3PCF scan.
# Enable with: make BALLTREE2BALLSMPION=1 cballs
BALLTREE2BALLSMPION = 1

# OCTREE2BALLSOMP
# TreeCorr-style dual/triple-node scan over the native cTreeBalls octree.
OCTREE2BALLSOMPON = 1

# OCTREE2BALLSMPI
# Deterministic MPI+OpenMP dual-node 2PCF and LogMultipole 3PCF scan.
# Enable with: make OCTREE2BALLSMPION=1 cballs
OCTREE2BALLSMPION = 1

# BALLTREE2BALLSOMP3PCF
# TreeCorr-style triple-node task traversal for scalar 3pcf.
BALLTREE2BALLSOMP3PCFON = 1

# BALLTREE2BALLSMPI3PCF
# Deterministic MPI+OpenMP FCFC ball-tree LogMultipole scalar 3pcf.
# Enable with: make BALLTREE2BALLSMPI3PCFON=1 TPCFON=1 cballs
BALLTREE2BALLSMPI3PCFON = 1

# BALLTREEMPI
# Optional FCFC-style distributed-memory scheduler for the ball tree.
# Enable with: make BALLTREEMPION=1 cballs
BALLTREEMPION = 1

# OCTREEGGGMPI
# FCFC-style MPI scheduler for the octree-GGG estimator.
# Enable with: make OCTREEGGGMPION=1 cballs
# Keep MPI work claims independent of the OpenMP reduction block so MPI ranks
# retain sufficiently fine-grained dynamic load balancing.
GGG_MPI_PIVOT_CLAIM_SIZE ?= 65536
OCTREEGGGMPION = 1

# LYAFORESTOMP
# Exact weighted Lyman-alpha forest 2PCF and anisotropic 3PCF.
LYAFORESTOMPON = 1
# MPI counterparts for all seven Ly-alpha modes; OpenMP-only siblings are optional.
LYAFORESTMPION = 1
# Fixed pivot grouping for deterministic radial OpenMP reductions.
LYA1D_OMP_PIVOT_BLOCK_SIZE ?= 256

# OCTREESHEAROMP
# Flat-sky weak-lensing shear 2PCF and natural 3PCF multipoles.
# Enable with: make OCTREESHEAROMPON=1 cballs
OCTREESHEAROMPON ?= 1

# KDTREEBOXOMP
# For computing 2pcf using kdtree-box-omp methods
KDTREEBOXOMPON = 1

# NEIGHBORBOXESOMP
# For computing 2pcf using neighbor-boxes-omp method
NEIGHBORBOXESOMPON = 1

# Gadget I/O
# For input data catalog in gadget format
GADGETIOON = 1

# CLASSLIB
# Several I/O routines from CLASS
CLASSLIBON = 1

# PXD
# For cython interfacing...
ifeq ($(CLASSLIBON),1)
PXDON = 1
else
$(info To compile with PXD needs CLASSLIBON = 1, deactivating...)
PXDON = 0
endif

# IOLIB
# Several additional I/O routines
IOLIBON = 1

# CFITSIOLIB
# internal cfitsio lib.
#   Default is 1, means sources are included and installed
#   if set to 0, means you have to install cfitsio library by your self
#   or ask administrator to have it for you.
CFITSIOLIBON = 1

# CFITSIO
# To IO fits format
# This addon requires IOLIBON = 1, check it...
ifeq ($(IOLIBON),1)
# default is ON.
# When user knows where cfitsio lib/include directories live,
#   make if necessary respective changes in Makefile_machine file
#   and then set it ON. If not turn it OFF (=0)
CFITSIOON = 1
else
$(info To compile with CFITSIO needs IOLIBON = 1, deactivating...)
CFITSIOON = 0
endif

#E Set of settings
#================================================================


############################
#B Special behavior settings
# In some searching methods
#   it will be possible to set the following flags

# smoothing pivot
# remember to use "options=smooth-pivot" in some addons,
#   like BALLSOMP, OCTREEKKKOMP, KDTREEBOXOMP, KDTREEOMP, NEIGHBORBOXOMP, OCTREEBOXOMP,
#       OCTREESINCOSOMP, TREEOMPSINCOS
# note that SMOOTHPIVOTON collide with ORIGINALCB (used in neighbor boxes method)
#   needs that ORIGINALCBON = 0 see below...
SMOOTHPIVOTON = 0
# Compute and add pivot neighbours when smooth-pivot support is enabled.
ADDPIVOTNEIGHBOURSON ?= 0
#

############################
# Nothing to do below, unless it is explicitly asked for
############################

# WKAvg switch...
# Default is 0. If set to 0 will give tests OK (./run_tests_all; ./run_all_tests_public)
NOWKAvgON = 0

# NMultipoles switch (multipoles for counting).
# Default is 1
NMultipolesON = 1

# NONORMHIST switch (do not use normalization of histograms).
#   If activated histograms can be saved
#   normalizing with monopole of N.
# Default is 1
NONORMHISTON = 1

# POLARAXIS switch (set north pole as the axis of reference...)
#   this is for pixel catalogs on the unit sphere: (0,0,1)
POLARAXISON = 0

# No Limber aproximation
NOLIMBERON = 0

# To remove overcounting pairs:
OVERCOUNTINGON = 0

# NOSTANDARNORMHISTON switch
#   If activated histograms are saved without normalization
#   only for kdtree-omp and tree-omp-sincos searching methods
# Default is 0
NOSTANDARNORMHISTON = 0

# CMDLINE_DEFS_UNITSPHERE
# set of useful default values for the unit sphere
CMDLINE_DEFS_UNITSPHERE_ON = 1

#B for some addons will be useful this switches
DEFINEFLAGS =
#
# TWOPCFCONVERGENCE
TWOPCFON = 1
# THREEPCFCONVERGENCE
TPCFON = 1
# THREEPCFSHEAR :: in octree-ggg-omp THREEPCFSHEAR -> TPCFSHEAR
TPCFSHEARON = 0
#
PRUNEON = 1
#
# BALLS4SCANLEVON
# will give the two balls condition...
#   needs that ORIGINALCBON = 0 see below...
BALLS4SCANLEVON = 0
#
# if BALLS4SCANLEVON = 1
# used in octree-ggg-omp when NORMALHISTSCALE is on
# THETA control (activated with options=behavior-ball):
#   the fraction of a bin width (deltaR) by which it is ok to let the pairs miss the correct bin.
#   the default is to use 1 if deltaR <= 0.1, or 0.1/deltaR if deltaR > 0.1.
# logscale: goodTHETA = 0.1 / deltaR
# normal scale: goodTHETA = 0.1 * (rminHist + deltaR/2) / deltaR
# THETA = MIN(goodTHETA, 1.0)
#THETA = 0 # will give no behavior-ball, but check 1/0 divergence
#THETA = 1 # the bin will incorrect by 1 bin width
THETA = 1.25
#
# used in octree-ggg-omp, also THETA is used here
NORMALHISTSCALEON = 0
#
#B several definitions from/to cute-box Makefile
_DEBUGON_ = 0
LOGBINON = 0
# this is to recover some tests results
ORIGINALCBON = 0
#E

#E
############################

############################
# Nothing to do below...
############################

############################
#B Addendum of some not important
#   modules/switches or that are in
#   development phase
#   and it is not for the public version
# Normally they will be switched OFF

# OCTREE3PCF3DOMP
# 3D scalar 3PCF multipoles with spherical harmonics and OpenMP. Done by Eladio Moreno
OCTREE3PCF3DOMPON = 1
OCTREE3PCF3DMPION = 1
# Fixed reduction blocks, independent of MPI ranks and OpenMP thread count.
CB3D_OMP_PIVOT_BLOCK_SIZE ?= 64

# OCTREESMOOTHING
# some utils and definitions useful to smooth octree cells
OCTREESMOOTHINGON = 0

#B This causes division by zero in MainLoop calling using cballys...
# OCTREEKKKOMP
# For computing 3pcf using octree-kkk-omp
ifeq ($(DEFDIMENSION),3)
OCTREEKKKOMPON = 0
endif

# BALLSOMP
# For computing 3pcf using balls method
BALLSON = 0

BALLS0357ON = 0

ALLOW_BALLS_WITH_SMOOTHING ?= 0


# OCTREEBALLS4OMP
# For computing 2pcf and 3pcf using octree-balls4-omp
# Uses the normal treeload and its own BALLS4 pivot partition, independently
# of OCTREESMOOTHINGON, BALLSON, and BALLS4SCANLEVON.
OCTREEBALLS4OMPON = 1
# Independent of SMOOTHPIVOTON; options=smooth-pivot is not supported.
OCTREEBALLS4MPION = 1

# OCTREEGGGCROSSOMP
# For computing cross-3pcf using octree-ggg_cross-omp
#   still in development phase.
ifeq ($(USEGSL),1)
OCTREEGGGCROSSOMPON = 0
else
ifeq ($(COMPLEXLIBON),1)
OCTREEGGGCROSSOMPON = 0
else
$(info To compile with OCTREEGGGCROSSOMP needs USEGSL/COMPLEXLIBON = 1, deactivating...)
# Note:
#                           testing without GSL !!!!!!!!!!!!!!!!!!!!!!!
#OCTREEGGGCROSSOMPON = 0
OCTREEGGGCROSSOMPON = 0
endif
endif

# DIRECTMETHOD
# For computing 3pcf using direct method
DIRECTMETHODON = 0

# OCTREEGGG
# For computing 3pcf using octree-ggg
#   still is in development phase.
ifeq ($(USEGSL),1)
OCTREEGGGON = 0
else
ifeq ($(COMPLEXLIBON),1)
OCTREEGGGON = 0
else
$(info To compile with OCTREEGGG needs USEGSL/COMPLEXLIBON = 1, deactivating...)
# Note:
#                           testing without GSL !!!!!!!!!!!!!!!!!!!!!!!
#OCTREEGGGON = 1
OCTREEGGGON = 0
endif
endif

# DIRECTMETHODSIMPLE
# For computing 3pcf using direct method simple
DIRECTMETHODSIMPLEON = 0

# DIRECTMETHODSIMPLE
# For computing 3pcf using direct method simple loopId
DIRECTMETHODSIMPLELOOPIDON = 0

# For complex math use only one: USEGSL or COMPLEXLIB
#   COMPLEXLIB is in development phase.
#   Not included. Do not use.
# COMPLEXLIB
# Library for complex computation
ifeq ($(USEGSL),0)
# default is OFF, turn it ON if necessary (OCTREEGGGOMP)
COMPLEXLIBON = 0
else
$(info Use only one: USEGSL or COMPLEXLIB, deactivating COMPLEXLIB...)
COMPLEXLIBON = 0
endif

# OCTREEGGGOMPTRIANGLES
# For computing 3pcf using octree-ggg-omp-triangles
#   is in development phase. Not included. Do not use.
ifeq ($(USEGSL),1)
OCTREEGGGOMPTRIANGLESON = 0
else
$(info To compile with OCTREEGGGOMPTRIANGLES needs USEGSL = 1, deactivating...)
OCTREEGGGOMPTRIANGLESON = 0
endif

# OCTREEBOXOMP
# For computing 2pcf using octree-box-omp methods
OCTREEBOXOMPON = 0

# KDTREECUTEBOX
# For computing 2pcf using cute-box methods
KDTREECUTEBOXON = 0

# OCTREEKKKBALLS4OMPTRIANGLES
# For computing 3pcf using octree-kkk-balls4-omp-triangles
