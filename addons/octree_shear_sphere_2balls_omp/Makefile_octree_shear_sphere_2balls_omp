# dual-node-style two-cell full-sky weak-lensing shear estimator.

ifeq ($(OCTREESHEARSPHERE2BALLSOMPON),1)
OPT2 += -DOCTREESHEARSPHERE2BALLSOMP -DTHREEPCFSHEAR -DTWOPCF \
	-DSHEAR_OMP_PIVOT_BLOCK_SIZE=$(SHEAR_OMP_PIVOT_BLOCK_SIZE)
OCTREESHEARSPHERE2BALLSOMP = $(MDIR)/addons/octree_shear_sphere_2balls_omp/
vpath %.c $(OCTREESHEARSPHERE2BALLSOMP)
INCLUDES += -I$(OCTREESHEARSPHERE2BALLSOMP) \
	-I$(MDIR)/addons/shear_sphere_shared
HEADERFILES += $(wildcard $(OCTREESHEARSPHERE2BALLSOMP)/*.h)
EXTERNAL += search_octree_shear_sphere_2balls_omp.o
search_octree_shear_sphere_2balls_omp.o: \
	$(OCTREESHEARSPHERE2BALLSOMP)/search_octree_shear_sphere_2balls_omp.c \
	$(MDIR)/addons/shear_sphere_shared/shear_sphere_engine.c \
	$(MDIR)/addons/shear_sphere_shared/shear_sphere_dual_tree.h \
	$(MDIR)/addons/shear_sphere_shared/shear_sphere_frontier_scheduler.h
endif
