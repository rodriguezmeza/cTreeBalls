# ----- Deterministic MPI+OpenMP LogMultipole scan over the native octree -----

ifeq ($(OCTREE2BALLSMPION),1)
MPICC ?= mpicc
CC := $(MPICC)
OPT2 += -DOCTREE2BALLSMPI -DOCTREE2BALLS_GGG_MPI_COMPAT \
        -DCBALLS_MPI_ENABLED
ifeq ($(filter 1,$(OCTREEGGGOMPON) $(OCTREEGGGMPION)),)
OPT2 += -DGGG_OMP_PIVOT_CHUNK_SIZE=$(GGG_OMP_PIVOT_CHUNK_SIZE) \
        -DGGG_OMP_FRONTIER_TARGET_TASKS=$(GGG_OMP_FRONTIER_TARGET_TASKS) \
        -DGGG_OMP_FRONTIER_MIN_ACTIVE=$(GGG_OMP_FRONTIER_MIN_ACTIVE)
endif
ifneq ($(OCTREEGGGMPION),1)
OPT2 += -DGGG_MPI_PIVOT_CLAIM_SIZE=$(GGG_MPI_PIVOT_CLAIM_SIZE)
endif

OCTREE2BALLSMPI = $(MDIR)/addons/octree_2balls_mpi/
OCTREE2BALLSOMPSOURCE = $(MDIR)/addons/octree_2balls_omp/
vpath %.c $(OCTREE2BALLSMPI):$(OCTREE2BALLSOMPSOURCE)
vpath %.c $(MDIR)/addons/scalar_compat_shared:$(MDIR)/addons/scalar_compat_shared
INCLUDES += -I$(OCTREE2BALLSMPI) \
            -I$(OCTREE2BALLSOMPSOURCE) \
            -I$(MDIR)/addons/balltree_2balls_omp \
            -I$(MDIR)/addons/balltree_shared \
            -I$(MDIR)/addons/scalar_compat_shared \
            -I$(MDIR)/addons/scalar_compat_shared
HEADERFILES += $(wildcard $(OCTREE2BALLSMPI)/*.h)
EXTERNAL += fcfc_octree_2balls_mpi.o search_octree_2balls_mpi.o
ifneq ($(OCTREEGGGMPION),1)
EXTERNAL += fcfc_octree_ggg_mpi.o
endif
ifeq ($(filter 1,$(OCTREEGGGOMPON) $(OCTREEGGGMPION) $(OCTREE2BALLSOMPON)),)
EXTERNAL += search_octree_ggg_omp.o
endif

search_octree_2balls_mpi.o: \
	$(OCTREE2BALLSMPI)/search_octree_2balls_mpi.c \
	$(MDIR)/addons/octree_2balls_omp/octree_2balls_tree.c \
	$(MDIR)/addons/balltree_2balls_omp/search_balltree_2balls_omp.c \
	$(MDIR)/addons/native_octree_pair/native_octree_pair.h \
	$(MDIR)/addons/scalar_compat_shared/protodefs_octree_ggg_mpi.h
endif
