# ----- dual-node-style dual-ball/triple-node OpenMP addon -----

ifeq ($(BALLTREE2BALLSOMPON),1)
OPT2 += -DBALLTREE2BALLSOMP
BALLTREE2BALLSOMP = $(MDIR)/addons/balltree_2balls_omp/
vpath %.c $(BALLTREE2BALLSOMP)
INCLUDES += -I$(BALLTREE2BALLSOMP) -I$(MDIR)/addons/balltree_shared
HEADERFILES += $(wildcard $(BALLTREE2BALLSOMP)/*.h)
EXTERNAL += search_balltree_2balls_omp.o
search_balltree_2balls_omp.o: \
	$(BALLTREE2BALLSOMP)/search_balltree_2balls_omp.c \
	$(MDIR)/addons/balltree_shared/fcfc_balltree.h \
	$(BALLTREE2BALLSOMP)/dual_node_edge_correction.h
endif
