# Active public add-on profile
# Mario A. Rodriguez-Meza, Ciudad de Mexico

ifndef CTREEBALLS_ADDONS_SETTINGS_INCLUDED
CTREEBALLS_ADDONS_SETTINGS_INCLUDED := 1
include $(MACHINES_DIR)/addons/Makefile_addons_settings
endif

# Compile-time behavior shared by the active methods.
ifeq ($(SMOOTHPIVOTON),1)
OPT2 += -DSMOOTHPIVOT
endif
ifeq ($(TWOPCFON),1)
OPT2 += -DTWOPCF
endif
ifeq ($(TPCFON),1)
OPT2 += -DTHREEPCFCONVERGENCE -DTPCF
endif
ifeq ($(PRUNEON),1)
OPT2 += -DPRUNING
endif

DEFINEFLAGS += -DTHETA=$(THETA)
ifeq ($(BALLS4SCANLEVON),1)
DEFINEFLAGS += -DBALLS4SCANLEV
endif
ifeq ($(LOGBINON),1)
DEFINEFLAGS += -D_LOGBIN_
endif
# The linked-box implementation uses the cTreeBalls logarithmic-bin path.
DEFINEFLAGS += -DLOGBINCBON
ifeq ($(_DEBUGON_),1)
DEFINEFLAGS += -D_DEBUG_
endif
OPT2 += $(DEFINEFLAGS)

# Scalar KD-tree two-node methods.
ifneq ($(filter 1,$(KDTREE2BALLSOMPON) $(KDTREE2BALLSMPION)),)
include $(MACHINES_DIR)/addons/kdtree_2balls_omp/Makefile_kdtree_2balls_omp
endif
ifeq ($(KDTREE2BALLSMPION),1)
include $(MACHINES_DIR)/addons/kdtree_2balls_mpi/Makefile_kdtree_2balls_mpi
endif

# Shared PCA ball-tree builder and scalar ball-tree methods.
ifneq ($(filter 1,$(BALLTREE2BALLSOMPON) $(BALLTREE2BALLSMPION) $(BALLTREESHEARSPHERE2BALLSOMPON)),)
include $(MACHINES_DIR)/addons/balltree_shared/Makefile_balltree_shared
endif
ifeq ($(BALLTREE2BALLSOMPON),1)
include $(MACHINES_DIR)/addons/balltree_2balls_omp/Makefile_balltree_2balls_omp
endif
ifeq ($(BALLTREE2BALLSMPION),1)
include $(MACHINES_DIR)/addons/balltree_2balls_mpi/Makefile_balltree_2balls_mpi
endif

# Native-octree scalar methods and their shared pair kernel.
ifneq ($(filter 1,$(OCTREE2BALLSOMPON) $(OCTREE2BALLSMPION)),)
include $(MACHINES_DIR)/addons/native_octree_pair/Makefile_native_octree_pair
endif
ifeq ($(OCTREE2BALLSOMPON),1)
include $(MACHINES_DIR)/addons/octree_2balls_omp/Makefile_octree_2balls_omp
endif
ifeq ($(OCTREE2BALLSMPION),1)
include $(MACHINES_DIR)/addons/octree_2balls_mpi/Makefile_octree_2balls_mpi
endif

# Ly-alpha forest OpenMP and MPI methods.
ifneq ($(filter 1,$(LYAFORESTOMPON) $(LYAFORESTMPION)),)
include $(MACHINES_DIR)/addons/lya_forest_omp/Makefile_lya_forest_omp
endif
ifeq ($(LYAFORESTMPION),1)
include $(MACHINES_DIR)/addons/lya_forest_mpi/Makefile_lya_forest_mpi
endif

# Full-sky spin-2 OpenMP methods. Their common traversal is compiled through
# the three method modules and addons/shear_sphere_shared.
ifeq ($(OCTREESHEARSPHERE2BALLSOMPON),1)
include $(MACHINES_DIR)/addons/octree_shear_sphere_2balls_omp/Makefile_octree_shear_sphere_2balls_omp
endif
ifeq ($(KDTREESHEARSPHERE2BALLSOMPON),1)
include $(MACHINES_DIR)/addons/kdtree_shear_sphere_2balls_omp/Makefile_kdtree_shear_sphere_2balls_omp
endif
ifeq ($(BALLTREESHEARSPHERE2BALLSOMPON),1)
include $(MACHINES_DIR)/addons/balltree_shear_sphere_2balls_omp/Makefile_balltree_shear_sphere_2balls_omp
endif

# Periodic-box methods.
ifeq ($(KDTREEBOXOMPON),1)
include $(MACHINES_DIR)/addons/kdtree_shared/Makefile_kdtree_shared
include $(MACHINES_DIR)/addons/kdtree_box_omp/Makefile_kdtree_box_omp
endif
ifeq ($(NEIGHBORBOXESOMPON),1)
include $(MACHINES_DIR)/addons/neighbor_boxes_omp/Makefile_neighbor_boxes_omp
endif

# Active I/O and binding support.
ifeq ($(GADGETIOON),1)
include $(MACHINES_DIR)/addons/gadget_io/Makefile_gadget_io
endif
ifeq ($(CLASSLIBON),1)
include $(MACHINES_DIR)/addons/class_lib/Makefile_class_lib
endif
ifeq ($(IOLIBON),1)
include $(MACHINES_DIR)/addons/iolib/Makefile_iolib
endif
ifeq ($(CFITSIOON),1)
include $(MACHINES_DIR)/addons/cfitsio/Makefile_cfitsio
endif
ifeq ($(PXDON),1)
include $(MACHINES_DIR)/addons/pxd/Makefile_pxd
endif

# Common add-on include tree.
ADDONS_ON = 1
ADDONSDIR = $(MDIR)/addons
ADDONS = addons
vpath %.c $(ADDONS)
INCLUDES += -I$(ADDONSDIR)
INCLUDES += -I$(ADDONSDIR)/addons_include/addons
INCLUDES += -I$(ADDONSDIR)/addons_include
INCLUDES += -I$(ADDONSDIR)/addons_include/general_libs
INCLUDES += -I$(ADDONSDIR)/addons_include/include
INCLUDES += -I$(ADDONSDIR)/addons_include/source/search
INCLUDES += -I$(ADDONSDIR)/addons_include/source/startrun
INCLUDES += -I$(ADDONSDIR)/addons_include/source/testdata
INCLUDES += -I$(ADDONSDIR)/addons_include/source/cballs
INCLUDES += -I$(ADDONSDIR)/addons_include/source/cballsio
INCLUDES += -I$(ADDONSDIR)/addons_include/source/tree
INCLUDES += -I$(ADDONSDIR)/addons_include/source/cballsutils

HEADERFILES += $(wildcard $(ADDONSDIR)/*.h)
HEADERFILES += $(wildcard $(ADDONSDIR)/addons/*.h)
HEADERFILES += $(wildcard $(ADDONSDIR)/addons_include/*.h)
HEADERFILES += $(wildcard $(ADDONSDIR)/addons_include/general_libs/*.h)
HEADERFILES += $(wildcard $(ADDONSDIR)/addons_include/include/*.h)
HEADERFILES += $(wildcard $(ADDONSDIR)/addons_include/source/search/*.h)
HEADERFILES += $(wildcard $(ADDONSDIR)/addons_include/source/startrun/*.h)
HEADERFILES += $(wildcard $(ADDONSDIR)/addons_include/source/testdata/*.h)
HEADERFILES += $(wildcard $(ADDONSDIR)/addons_include/source/cballs/*.h)
HEADERFILES += $(wildcard $(ADDONSDIR)/addons_include/source/cballsio/*.h)
HEADERFILES += $(wildcard $(ADDONSDIR)/addons_include/source/tree/*.h)
HEADERFILES += $(wildcard $(ADDONSDIR)/addons_include/source/cballsutils/*.h)

# Active histogram and unit-sphere controls.
ifeq ($(NMultipolesON),1)
OPT2 += -DNMultipoles
endif
ifeq ($(NONORMHISTON),1)
OPT2 += -DNONORMHIST
endif
ifeq ($(CMDLINE_DEFS_UNITSPHERE_ON),1)
include $(MACHINES_DIR)/addons/cmdline_defs_settings/Makefile_cmdline_defs_settings
endif

# Physical 3D multipole methods.
ifneq ($(filter 1,$(OCTREE3PCF3DOMPON) $(OCTREE3PCF3DMPION)),)
include $(MACHINES_DIR)/addons/octree_3pcf_3d_omp/Makefile_octree_3pcf_3d_omp
endif
ifeq ($(OCTREE3PCF3DMPION),1)
include $(MACHINES_DIR)/addons/octree_3pcf_3d_mpi/Makefile_octree_3pcf_3d_mpi
endif
