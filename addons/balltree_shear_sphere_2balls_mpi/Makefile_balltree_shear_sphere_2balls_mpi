# MPI full-sky weak-lensing shear estimator over the FCFC PCA ball tree.

ifeq ($(BALLTREESHEARSPHERE2BALLSMPION),1)
OPT2 += -DBALLTREESHEARSPHERE2BALLSMPI -DCBALLS_MPI_ENABLED \
	-DTHREEPCFSHEAR -DTWOPCF \
	-DSHEAR_OMP_PIVOT_BLOCK_SIZE=$(SHEAR_OMP_PIVOT_BLOCK_SIZE)
BALLTREESHEARSPHERE2BALLSMPI = $(MDIR)/addons/balltree_shear_sphere_2balls_mpi/
vpath %.c $(BALLTREESHEARSPHERE2BALLSMPI)
INCLUDES += -I$(BALLTREESHEARSPHERE2BALLSMPI) \
	-I$(MDIR)/addons/balltree_shear_sphere_2balls_omp \
	-I$(MDIR)/support/shear_binary \
	-I$(MDIR)/support/spherical_shear \
	-I$(MDIR)/support/shear_kernel \
	-I$(MDIR)/support/pca_tree
HEADERFILES += $(wildcard $(BALLTREESHEARSPHERE2BALLSMPI)/*.h)
EXTERNAL += fcfc_balltree_shear_sphere_2balls_mpi.o \
	search_balltree_shear_sphere_2balls_mpi.o
ifneq ($(OCTREESHEARSPHEREOMPON),1)
vpath %.c $(MDIR)/support/spherical_shear
EXTERNAL += search_octree_shear_sphere_omp.o
endif
search_balltree_shear_sphere_2balls_mpi.o: \
	$(BALLTREESHEARSPHERE2BALLSMPI)/search_balltree_shear_sphere_2balls_mpi.c \
	$(MDIR)/support/shear_kernel/search_octree_shear_omp.c \
	$(MDIR)/support/shear_binary/shear_sphere_binary_scan.h \
	$(MDIR)/support/pca_tree/fcfc_balltree.h \
	$(MDIR)/support/spherical_shear/shear_sphere_dual_tree.h \
	$(MDIR)/support/spherical_shear/protodefs_octree_shear_sphere_omp.h \
	$(BALLTREESHEARSPHERE2BALLSMPI)/fcfc_balltree_shear_sphere_2balls_mpi.h
fcfc_balltree_shear_sphere_2balls_mpi.o: \
	$(BALLTREESHEARSPHERE2BALLSMPI)/fcfc_balltree_shear_sphere_2balls_mpi.c \
	$(BALLTREESHEARSPHERE2BALLSMPI)/fcfc_balltree_shear_sphere_2balls_mpi.h
endif
