# ----- MPI+OpenMP KD two-ball/LogMultipole addon -----

ifeq ($(KDTREE2BALLSMPION),1)
MPICC ?= mpicc
CC := $(MPICC)
OPT2 += -DKDTREE2BALLSMPI -DCBALLS_MPI_ENABLED
KDTREE2BALLSMPI = $(MDIR)/addons/kdtree_2balls_mpi/
vpath %.c $(KDTREE2BALLSMPI)
INCLUDES += -I$(KDTREE2BALLSMPI) \
            -I$(MDIR)/addons/kdtree_2balls_omp \
            -I$(MDIR)/addons/balltree_2balls_omp \
            -I$(MDIR)/addons/balltree_shared
HEADERFILES += $(wildcard $(KDTREE2BALLSMPI)/*.h)
EXTERNAL += fcfc_kdtree_2balls_mpi.o search_kdtree_2balls_mpi.o
search_kdtree_2balls_mpi.o: \
	$(KDTREE2BALLSMPI)/search_kdtree_2balls_mpi.c \
	$(MDIR)/addons/kdtree_2balls_omp/search_kdtree_2balls_omp.c \
	$(MDIR)/addons/balltree_2balls_omp/search_balltree_2balls_omp.c
endif
